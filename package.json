{
  "name": "2026-okfks-lab",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:subjects": "python scripts/refresh-source-packs.py",
    "export:lr01": "pnpm run build && node scripts/export_lr01_variants.mjs",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint src scripts tests",
    "test": "vitest run",
    "build": "pnpm run validate && pnpm run typecheck && vite build && node scripts/validate-dist.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm run test && pnpm run build",
    "adapt:content": "node scripts/adapt-context.mjs",
    "generate:reports": "python scripts/update-reports.py"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
